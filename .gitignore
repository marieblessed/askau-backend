# ── secrets ───────────────────────────────────────────────────────────────
# .env carries the database URLs, the dev-token secret and the Azure Storage
# credentials. .env.example is committed and is the documented shape.
.env
.env.*
!.env.example
# Generated by `make dev-tokens` for the web client; bearer tokens.
.dev-tokens.json

# ── Python ────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── editors and local tooling ─────────────────────────────────────────────
# Machine-specific paths, useful to one developer, noise in every diff.
.idea/
.vscode/
.claude/
*.iml
.DS_Store

# ── the requirements source documents ─────────────────────────────────────
# The AUC's originals: ~40 MB of mostly-images. Git stores binaries whole and
# forever, so every clone would pay for them in perpetuity, and the only way to
# remove them afterwards is a history rewrite that breaks everyone who already
# cloned. Nothing in the build reads them — they are read by people. See
# docs/README.md for how to obtain them.
docs/*.pdf
docs/*.docx

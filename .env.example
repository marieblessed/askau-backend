# AskAU configuration.
#
# Copy to `.env` and edit. Every variable is documented in docs/configuration.md
# — what it is for, where the value comes from, and what breaks without it.
#
# Only two have no default and must be set: ASKAU_DATABASE_URL and
# ASKAU_REDIS_URL. Everything else below is already a working value, chosen so a
# fresh checkout runs with no model, no tenant and no cloud account.
#
# Settings are validated at startup: a malformed or contradictory value stops the
# process with a message naming the variable.

# ─── Core ────────────────────────────────────────────────────────────────────
ASKAU_ENV=development
ASKAU_LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
# Port 5433, matching the `docker run` in README.md — a second Postgres on 5432
# is common, and connecting to the wrong one is a confusing failure rather than a
# loud one. Two roles on purpose: `askau_app` is subject to row-level security,
# the migration role is not. See docs/configuration.md.
ASKAU_DATABASE_URL=postgresql+asyncpg://askau_app:askau@localhost:5433/askau
ASKAU_DATABASE_RO_URL=
ASKAU_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/askau
ASKAU_DB_POOL_SIZE=10
ASKAU_DB_MAX_OVERFLOW=5

# ─── Redis ───────────────────────────────────────────────────────────────────
ASKAU_REDIS_URL=redis://localhost:6379/3

# ─── Identity ────────────────────────────────────────────────────────────────
# dev   = locally-signed tokens for seeded identities, no Entra tenant needed
# entra = real OIDC against Microsoft Entra ID
ASKAU_AUTH_MODE=dev
ASKAU_DEV_TOKEN_SECRET=dev-only-not-a-real-secret-change-me
ASKAU_ENTRA_TENANT_ID=
ASKAU_ENTRA_CLIENT_ID=
ASKAU_ENTRA_AUDIENCE=

# ── Azure Blob Storage ingestion (app-only) ─────────────────────────────────
#
# A separate app registration from the one above. That one validates user
# tokens; this one reads document containers with nobody signed in, and one
# compromised secret should not be both.
#
# Required role on the container: Storage Blob Data Reader — assigned per
# container, so a misconfiguration is bounded by what was deliberately shared.
#
# Blob storage has no per-blob permissions, so each source declares where its
# audience comes from in `location.acl_strategy` — see
# askau/ingestion/connectors/azure_blob.py.
#
# Leave empty to leave the connector unconfigured; `test-connection` then says
# so plainly rather than failing with an authentication error that reads like a
# tenant problem.
ASKAU_AZURE_STORAGE_CLIENT_ID=
ASKAU_AZURE_STORAGE_CLIENT_SECRET=
# An alternative to the service principal, for the emulator or a time-boxed
# test. No account-key setting exists on purpose: an account key grants
# everything the account can do, to anyone holding it, with no expiry.
ASKAU_AZURE_STORAGE_SAS_TOKEN=

# ─── Embeddings (FR-042: provider behind a port) ─────────────────────────────
# hash | sentence_transformers | openai_compatible
ASKAU_EMBEDDING_PROVIDER=hash
ASKAU_EMBEDDING_MODEL=hash-1024
ASKAU_EMBEDDING_DIM=1024
ASKAU_EMBEDDING_BASE_URL=
ASKAU_EMBEDDING_API_KEY=

# ─── Answer quality gates ────────────────────────────────────────────────────
# Where "I could not answer that" is decided. Below the groundedness floor an
# answer is refused outright; between it and 0.75 it is shown with a caveat.
ASKAU_MIN_EVIDENCE_SCORE=0.015
ASKAU_MIN_EVIDENCE_CHUNKS=1
ASKAU_GROUNDEDNESS_FLOOR=0.40
ASKAU_CONTEXT_TOKEN_BUDGET=6000

# ─── Answer generation (FR-042: provider behind a port) ──────────────────────
# echo              = deterministic stand-in, no model needed. The default, and
#                     what makes a local checkout work with nothing installed.
#                     Refused when ASKAU_ENV=production.
# openai_compatible = any endpoint speaking the OpenAI chat API — Ollama,
#                     vLLM, llama.cpp, a hosted provider.
#
# For a local model via Ollama on the default port:
#   ASKAU_LLM_PROVIDER=openai_compatible
#   ASKAU_LLM_BASE_URL=http://localhost:11434/v1
#   ASKAU_LLM_MODEL=llama3.1:8b
ASKAU_LLM_PROVIDER=echo
ASKAU_LLM_MODEL=echo-1
ASKAU_LLM_BASE_URL=
ASKAU_LLM_API_KEY=
ASKAU_LLM_MAX_TOKENS=800

# ─── Retrieval ───────────────────────────────────────────────────────────────
ASKAU_RETRIEVER=pgvector_hybrid
ASKAU_RETRIEVAL_CANDIDATE_K=60
ASKAU_RETRIEVAL_TOP_K=8
ASKAU_RERANKER=noop
ASKAU_RERANK_INPUT_K=40
ASKAU_RRF_K=60
# Hard floor: below 0.8, a selective ACL filter makes HNSW under-return silently.
ASKAU_MIN_PGVECTOR_VERSION=0.8.0
ASKAU_HNSW_ITERATIVE_SCAN=relaxed_order
ASKAU_HNSW_MAX_SCAN_TUPLES=20000

# ─── Caching / limits ────────────────────────────────────────────────────────
ASKAU_AUTHZ_CACHE_TTL=300
ASKAU_EMBED_CACHE_TTL=86400
ASKAU_RATE_LIMIT_PER_MINUTE=30
ASKAU_RATE_LIMIT_PER_HOUR=300

# ─── Ingestion ───────────────────────────────────────────────────────────────
ASKAU_CHUNK_TARGET_TOKENS=380
ASKAU_CHUNK_OVERLAP_TOKENS=60
ASKAU_CHUNK_MAX_TOKENS=512
# OCR runs as a container (Apache Tika), never installed on this host — a
# host engine makes behaviour depend on machine provisioning and fails silently.
# 'none' rejects scans with an actionable message instead. See
# docs/architecture/16-host-dependencies.md
ASKAU_OCR_PROVIDER=none
ASKAU_OCR_URL=
ASKAU_OCR_LANGUAGES=eng
ASKAU_ACL_SYNC_INTERVAL_SECONDS=900
